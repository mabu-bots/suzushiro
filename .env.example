# Discord Bot のトークン（必須）
DISCORD_TOKEN=YOUR_BOT_TOKEN

# 起動時にゲーム DB のバックアップを作るか（false で無効。既定は有効）
DB_BACKUP_ON_START=true
# DB バックアップの保持世代数（既定 10）
DB_BACKUP_RETENTION=10

# ゲームデータ（games.db）の保存先（未設定時は src/data）
# SUZUSHIRO_DATA_DIR=/path/to/data

# コマンド別の許可チャンネル（すべて未設定なら全チャンネルで実行可）
# DEFAULT_COMMAND_CHANNELS=
# COMMAND_CHANNELS_OMIKUJI=
# COMMAND_CHANNELS_RANDOM=
# COMMAND_CHANNELS_TODAY=
# COMMAND_CHANNELS_GAME=
# COMMAND_CHANNELS_GAME_LOGS=
# COMMAND_CHANNELS_GAME_POINTS=
# COMMAND_CHANNELS_GAME_STATS=
# COMMAND_CHANNELS_PROFILE=
# COMMAND_CHANNELS_RANKING=
